{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./*"],
      "@src/*": ["src/*"],
      "src/*": ["src/*"],
      "constants/*": ["constants/*"],
      "lib/*": ["lib/*"],
      "i18n/*": ["i18n/*"],
      "db/*": ["db/*"],
      "components/*": ["src/components/*"]
    },
    "types": ["jest"]
  },
  "exclude": ["node_modules"]
}
