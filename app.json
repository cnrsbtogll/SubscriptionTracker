{
  "expo": {
    "name": "Subscription Tracker",
    "slug": "subwise",
    "scheme": "subwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.subwise.cnr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.subwise.cnr",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E3A5F"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3739fd03-ae10-48ff-8c5f-1ed4dcbae3a6"
      }
    },
    "owner": "cnrsbtogll"
  }
}
